# GC Forms API key JSON file downloaded from GC Forms. Keep it outside source control.
FORMS_API_KEY_FILE=./credentials/form_private_api_key.json

# Zitadel project identifier shown in the GC Forms API setup.
FORMS_PROJECT_ID=

# Production defaults. Use the staging URLs when testing against a staging form.
FORMS_API_URL=https://api.forms-formulaires.alpha.canada.ca/v1
FORMS_IDP_URL=https://auth.forms-formulaires.alpha.canada.ca

OUTPUT_DIR=./output
POLL_INTERVAL_SECONDS=60

# After the formatted files and attachments are safely written, acknowledge the
# response to GC Forms. Set false to leave submissions unconfirmed.
CONFIRM_AFTER_SUCCESS=true
